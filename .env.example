# DVLA Vehicle Enquiry Service API Key
# Get your key from: https://driver-vehicle-licensing.api.gov.uk/
# Required to fetch real vehicle data. If not set, system falls back to mock data.
DVLA_VES_API_KEY=your_api_key_here

# Future enhancement: MOT API (not currently used)
DVSA_MOT_API_KEY=
DVSA_MOT_CLIENT_ID=
DVSA_MOT_CLIENT_SECRET=
DVSA_MOT_SCOPE_URL= 
DVSA_MOT_TOKEN_URL=